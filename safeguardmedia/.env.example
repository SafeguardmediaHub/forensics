# ── Server ────────────────────────────────────────────────────────────────────
ENV=development
PORT=8000

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/safeguardmedia/uploads
OUTPUT_DIR=/tmp/safeguardmedia/outputs

# ── File Size Limits (MB) ─────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=500
MAX_AUDIO_SIZE_MB=201
MAX_IMAGE_SIZE_MB=50

# ── Cleanup ───────────────────────────────────────────────────────────────────
CLEANUP_MAX_AGE_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Use ["*"] for development only.
CORS_ORIGINS=["*"]
# Production example:
# CORS_ORIGINS=["https://yourdomain.com","https://app.yourdomain.com"]

# ── Engine Thresholds (optional — all have defaults) ─────────────────────────
# Frame Analysis
# FA_TAMPERED_CONFIDENCE=80.0
# FA_REVIEW_CONFIDENCE=30.0

# Visual Forensics
# VF_TAMPERED_THRESHOLD=60.0
# VF_REVIEW_THRESHOLD=30.0

# Video Forensics
# VFO_TAMPERED_CONFIDENCE=75.0
# VFO_REVIEW_CONFIDENCE=35.0
